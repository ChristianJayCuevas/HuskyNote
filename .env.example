# HuskyNote Client Environment Configuration
# All variables prefixed with VITE_ are exposed to the client bundle.
# No secrets or private tokens should ever be defined here.

VITE_APP_NAME=HuskyNote
VITE_APP_VERSION=0.1.0

# Local AI Defaults (Configurable via in-app settings UI as well)
VITE_OLLAMA_BASE_URL=http://localhost:11434
VITE_DEFAULT_MODEL=llama3.2:latest

# Optional Local Python Companion URL
VITE_LOCAL_COMPANION_URL=http://localhost:8765
